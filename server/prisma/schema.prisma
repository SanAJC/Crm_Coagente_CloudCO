// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Fuente de verdad del modelo de datos: ../modelo_crm.sql

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =====================================================================
// MODULO 1: USUARIOS Y PERMISOS (RBAC)
// =====================================================================

/// `esAdmin` marca el rol con control total sobre el modulo de usuarios.
/// A lo sumo un rol puede tener esAdmin = true: hay un indice unico parcial
/// sobre esta columna en la migracion (Prisma Schema Language no lo expresa).
model Role {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique @db.VarChar(50)
  descripcion String?  @db.VarChar(255)
  esAdmin     Boolean  @default(false) @map("es_admin")
  createdAt   DateTime @default(now()) @map("created_at")

  rolesPermisos RolePermiso[]
  usuariosRoles UsuarioRole[]

  @@map("roles")
}

model Permiso {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique @db.VarChar(100)
  modulo      String  @db.VarChar(50)
  descripcion String? @db.VarChar(255)

  rolesPermisos RolePermiso[]

  @@map("permisos")
}

model RolePermiso {
  roleId    Int @map("role_id")
  permisoId Int @map("permiso_id")

  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([roleId, permisoId])
  @@map("roles_permisos")
}

model Usuario {
  id           Int       @id @default(autoincrement())
  nombre       String    @db.VarChar(100)
  email        String    @unique @db.VarChar(150)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  telefono     String?   @db.VarChar(30)
  estado       String    @default("activo") @db.VarChar(20)
  ultimoLogin  DateTime? @map("ultimo_login")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  usuariosRoles     UsuarioRole[]
  productosCreados  Producto[]         @relation("ProductoCreadoPor")
  reservasAtendidas Reserva[]
  pedidosAtendidos  Pedido[]
  ticketsAsignados  Ticket[]           @relation("TicketAsignadoA")
  ticketsCreados    Ticket[]           @relation("TicketCreadoPor")
  mensajesEnviados  Mensaje[]
  refreshTokens     RefreshToken[]
  blacklistedTokens BlacklistedToken[]

  @@map("usuarios")
}

model UsuarioRole {
  usuarioId Int @map("usuario_id")
  roleId    Int @map("role_id")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([usuarioId, roleId])
  @@map("usuarios_roles")
}

model RefreshToken {
  id        String   @id @default(uuid())
  usuarioId Int      @map("usuario_id")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  tokenHash String
  jti       String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model BlacklistedToken {
  id        String   @id @default(uuid())
  usuarioId Int      @map("usuario_id")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  jti       String   @unique
  expiresAt DateTime
  reason    String?
  createdAt DateTime @default(now())
}

// =====================================================================
// MODULO 2: PRODUCTOS
// =====================================================================

model Categoria {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique @db.VarChar(100)
  descripcion String? @db.VarChar(255)

  productos Producto[]

  @@map("categorias")
}

model Producto {
  id          Int      @id @default(autoincrement())
  sku         String   @unique @db.VarChar(50)
  nombre      String   @db.VarChar(150)
  descripcion String?
  categoriaId Int?     @map("categoria_id")
  precio      Decimal  @db.Decimal(12, 2)
  costo       Decimal? @default(0) @db.Decimal(12, 2)
  stockActual Int      @default(0) @map("stock_actual")
  stockMinimo Int?     @default(0) @map("stock_minimo")
  imagenUrl   String?  @map("imagen_url") @db.VarChar(255)
  estado      String   @default("activo") @db.VarChar(20)
  createdBy   Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  categoria      Categoria?      @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  creadoPor      Usuario?        @relation("ProductoCreadoPor", fields: [createdBy], references: [id])
  pedidoDetalles PedidoDetalle[]

  @@index([categoriaId], map: "idx_productos_categoria")
  @@map("productos")
}

// =====================================================================
// MODULO 3: CLIENTES
// =====================================================================

model Cliente {
  id          Int      @id @default(autoincrement())
  nombre      String   @db.VarChar(150)
  email       String?  @unique @db.VarChar(150)
  telefono    String?  @db.VarChar(30)
  direccion   String?  @db.VarChar(255)
  tipoCliente String?  @default("regular") @map("tipo_cliente") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")

  reservas       Reserva[]
  pedidos        Pedido[]
  conversaciones Conversacion[]

  @@map("clientes")
}

// =====================================================================
// MODULO 4: RESERVAS
// =====================================================================

model Reserva {
  id           Int       @id @default(autoincrement())
  clienteId    Int       @map("cliente_id")
  usuarioId    Int?      @map("usuario_id")
  fechaReserva DateTime  @default(now()) @map("fecha_reserva")
  fechaInicio  DateTime? @map("fecha_inicio")
  fechaFin     DateTime? @map("fecha_fin")
  estado       String    @default("pendiente") @db.VarChar(20)
  notas        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  cliente Cliente  @relation(fields: [clienteId], references: [id])
  usuario Usuario? @relation(fields: [usuarioId], references: [id])
  pedidos Pedido[]

  @@index([clienteId], map: "idx_reservas_cliente")
  @@map("reservas")
}

// =====================================================================
// MODULO 5: PEDIDOS
// =====================================================================

model Pedido {
  id             Int      @id @default(autoincrement())
  clienteId      Int      @map("cliente_id")
  reservaId      Int?     @map("reserva_id")
  usuarioId      Int?     @map("usuario_id")
  fechaPedido    DateTime @default(now()) @map("fecha_pedido")
  estado         String   @default("pendiente") @db.VarChar(20)
  total          Decimal  @default(0) @db.Decimal(12, 2)
  direccionEnvio String?  @map("direccion_envio") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  cliente        Cliente         @relation(fields: [clienteId], references: [id])
  reserva        Reserva?        @relation(fields: [reservaId], references: [id])
  usuario        Usuario?        @relation(fields: [usuarioId], references: [id])
  pedidoDetalles PedidoDetalle[]
  tickets        Ticket[]

  @@index([clienteId], map: "idx_pedidos_cliente")
  @@index([reservaId], map: "idx_pedidos_reserva")
  @@map("pedidos")
}

/// El campo `subtotal` es una columna GENERATED ALWAYS AS (cantidad * precio_unitario) STORED
/// en PostgreSQL (ver modelo_crm.sql); no debe escribirse desde la capa de aplicacion.
model PedidoDetalle {
  id             Int     @id @default(autoincrement())
  pedidoId       Int     @map("pedido_id")
  productoId     Int     @map("producto_id")
  cantidad       Int
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(12, 2)
  subtotal       Decimal @db.Decimal(12, 2)

  pedido   Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])

  @@index([pedidoId], map: "idx_pedido_detalle_ped")
  @@map("pedido_detalle")
}

// =====================================================================
// MODULO 6: TICKETS (SOPORTE / ATENCION AL CLIENTE)
// Un ticket es un caso o reporte sobre un problema de atencion con un cliente
// (incidencia, consulta, devolucion, seguimiento general). pedidoId es opcional:
// se usa solo cuando el caso esta relacionado con un pedido puntual, no siempre.
// =====================================================================

model Ticket {
  id              Int       @id @default(autoincrement())
  pedidoId        Int?      @map("pedido_id")
  tipo            String    @default("seguimiento") @db.VarChar(30)
  asunto          String    @db.VarChar(150)
  descripcion     String?
  prioridad       String    @default("media") @db.VarChar(20)
  estado          String    @default("abierto") @db.VarChar(20)
  asignadoA       Int?      @map("asignado_a")
  creadoPor       Int?      @map("creado_por")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  fechaResolucion DateTime? @map("fecha_resolucion")

  pedido         Pedido?        @relation(fields: [pedidoId], references: [id])
  asignado       Usuario?       @relation("TicketAsignadoA", fields: [asignadoA], references: [id])
  creador        Usuario?       @relation("TicketCreadoPor", fields: [creadoPor], references: [id])
  conversaciones Conversacion[]

  @@index([pedidoId], map: "idx_tickets_pedido")
  @@index([estado], map: "idx_tickets_estado")
  @@index([asignadoA], map: "idx_tickets_asignado")
  @@map("tickets")
}

// =====================================================================
// MODULO 7: CONVERSACIONES Y MENSAJES (integracion multicanal via n8n)
// =====================================================================

model Conversacion {
  id              Int       @id @default(autoincrement())
  clienteId       Int?      @map("cliente_id")
  canal           String    @db.VarChar(20)
  canalChatId     String    @map("canal_chat_id") @db.VarChar(150)
  ticketId        Int?      @map("ticket_id")
  estado          String    @default("abierta") @db.VarChar(20)
  ultimoMensajeAt DateTime? @map("ultimo_mensaje_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  cliente  Cliente?  @relation(fields: [clienteId], references: [id])
  ticket   Ticket?   @relation(fields: [ticketId], references: [id])
  mensajes Mensaje[]

  @@unique([canal, canalChatId])
  @@index([clienteId], map: "idx_conversaciones_cliente")
  @@index([ticketId], map: "idx_conversaciones_ticket")
  @@map("conversaciones")
}

/// El indice unico sobre `canalMensajeId` es parcial (WHERE canal_mensaje_id IS NOT NULL)
/// y el indice de `metadata` es GIN; ambos se agregan a mano en la migracion SQL
/// porque Prisma Schema Language no los expresa de forma nativa.
model Mensaje {
  id                  Int      @id @default(autoincrement())
  conversacionId      Int      @map("conversacion_id")
  canalMensajeId      String?  @map("canal_mensaje_id") @db.VarChar(150)
  remitente           String   @db.VarChar(20)
  tipoContenido       String   @default("texto") @map("tipo_contenido") @db.VarChar(20)
  contenido           String?
  urlAdjunto          String?  @map("url_adjunto") @db.VarChar(500)
  metadata            Json?
  enviadoPorUsuarioId Int?     @map("enviado_por_usuario_id")
  createdAt           DateTime @default(now()) @map("created_at")

  conversacion Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  enviadoPor   Usuario?     @relation(fields: [enviadoPorUsuarioId], references: [id])

  @@index([conversacionId], map: "idx_mensajes_conversacion")
  @@map("mensajes")
}
